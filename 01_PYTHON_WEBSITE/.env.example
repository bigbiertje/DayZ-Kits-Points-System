# Copy this file to .env if you use python-dotenv, or set these as environment variables.
# The run_windows.bat file also shows simple set commands.

DZKP_PORT=8080
DZKP_SECRET_KEY=CHANGE_ME_RANDOM_SITE_SECRET
DZKP_API_SECRET=CHANGE_ME_RANDOM_API_SECRET

DZKP_ADMIN_USERNAME=admin
DZKP_ADMIN_PASSWORD=change-this-admin-password

# Optional custom database path:
# DZKP_DB_PATH=data/site.db

# Public URL, needed for Steam/Discord redirects.
DZKP_PUBLIC_BASE_URL=http://localhost:8080

# Discord OAuth app settings.
DZKP_DISCORD_CLIENT_ID=CHANGE_DISCORD_CLIENT_ID
DZKP_DISCORD_CLIENT_SECRET=CHANGE_DISCORD_CLIENT_SECRET
DZKP_DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
